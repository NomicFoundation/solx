// SPDX-License-Identifier: MIT

pragma solidity >=0.8.0;

// The internal function step returns two values and is called twice in walk
// with the same argument, once for its second result and once for its side
// effects. The EVM list scheduler used to assert on this shape because the
// results of a call are virtual registers while it treated them as implicit
// physical register defs.
contract Test {
    mapping(uint256 => uint256) next;
    mapping(uint256 => uint256) weight;

    event Seen(uint256 from, uint256 to);

    function step(uint256 cursor) internal returns (uint256 seen, uint256 following) {
        following = cursor;
        for (uint256 i = 0; i < 8; i++) {
            following = next[following];
            if (following == 0) break;
            weight[following] += i;
            emit Seen(cursor, following);
            seen++;
        }
        for (uint256 i = 0; i < seen; i++) {
            weight[cursor + i] = weight[following] / (i + 1);
            emit Seen(following, weight[cursor + i]);
        }
    }

    function walk(uint256 cursor) internal {
        while (cursor != 0) {
            (, uint256 following) = step(cursor);
            step(cursor);
            cursor = following;
        }
    }

    function link(uint256 from, uint256 to) external { next[from] = to; }
    function weightOf(uint256 key) external view returns (uint256) { return weight[key]; }

    function w1(uint256 c) external { walk(c); }
    function w2(uint256 c) external { walk(c + 1); }

    function a1(uint256 c) external returns (uint256, uint256) { return step(c); }
    function a2(uint256 c) external returns (uint256, uint256) { return step(c + 1); }
}
