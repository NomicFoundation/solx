// SPDX-License-Identifier: MIT

pragma solidity >=0.8.0;

contract Test {
    function f() public pure returns (uint256 p, bytes memory y) {
        bytes memory x = new bytes(1);
        y = bytes.concat(x, bytes1(0x02));
        assembly {
            p := mload(0x40)
        }
    }

    function g() public pure returns (uint256 p, bytes memory y) {
        bytes memory x = new bytes(3);
        y = bytes.concat(x, x, bytes2(0x0102));
        assembly {
            p := mload(0x40)
        }
    }

    function h() public pure returns (uint256 p, bytes memory y) {
        bytes memory x = new bytes(1);
        y = bytes.concat("abc", x);
        assembly {
            p := mload(0x40)
        }
    }

    function k() public pure returns (uint256 p, string memory y) {
        string memory x = new string(1);
        y = string.concat(x, x);
        assembly {
            p := mload(0x40)
        }
    }

    function l() public pure returns (uint256 p, string memory y) {
        string memory x = new string(5);
        y = string.concat(x);
        assembly {
            p := mload(0x40)
        }
    }

    function m() public returns (uint256 p, uint256 q, uint256 n) {
        address a;
        assembly {
            mstore(0, 0x60216000f3000000000000000000000000000000000000000000000000000000)
            a := create(0, 0, 5)
        }
        bytes memory c = a.code;
        assembly {
            p := mload(0x40)
            q := c
        }
        n = c.length;
    }
}
