pragma solidity >=0.8.0;

contract Test {
    function e(uint256 x) external pure {}

    function f() public pure returns (uint256 p, bytes memory y) {
        y = abi.encodePacked(uint8(1), uint16(0x6162));
        assembly {
            p := mload(0x40)
        }
    }

    function g() public pure returns (uint256 p, bytes memory y) {
        y = abi.encodeWithSelector(0x12345678, uint256(7));
        assembly {
            p := mload(0x40)
        }
    }

    function h() public pure returns (uint256 p, bytes memory y) {
        y = abi.encodeWithSignature("e(uint256)", uint256(7));
        assembly {
            p := mload(0x40)
        }
    }

    function k() public view returns (uint256 p, bytes memory y) {
        y = abi.encodeCall(this.e, (7));
        assembly {
            p := mload(0x40)
        }
    }

    function l() public pure returns (uint256 p, bytes memory y) {
        bytes memory x = abi.encodePacked(uint8(1));
        y = abi.encodePacked(x, uint16(2));
        assembly {
            p := mload(0x40)
        }
    }

    function m() public returns (uint256 p) {
        address(this).call(abi.encodeWithSignature("e(uint256)", uint256(7)));
        assembly {
            p := mload(0x40)
        }
    }
}
