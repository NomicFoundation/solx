pragma solidity >=0.8.0;

contract Test {
    string constant C = "abc";

    function k(string calldata) external pure {}

    function f() public pure returns (bytes memory b, uint256 p) {
        b = abi.encode("abc");
        assembly {
            p := mload(0x40)
        }
    }

    function g() public pure returns (bytes memory) {
        return abi.encodePacked("a", hex"ff", "bc", "", "abcdefghijklmnopqrstuvwxyz0123456");
    }

    function h() public pure returns (bytes memory) {
        return abi.encodeWithSelector(0x12345678, "q", uint256(7), "");
    }

    function l() public pure returns (bytes memory) {
        return abi.encodeWithSignature("f(string)", "w");
    }

    function m() public view returns (bytes memory) {
        return abi.encodeCall(this.k, ("e"));
    }

    function n() public pure returns (bytes memory, bytes memory) {
        return (abi.encode("a b"), abi.encode("ab"));
    }

    function q() public pure returns (bytes memory) {
        return abi.encode(bytes("x"), C, "", "abcdefghijklmnopqrstuvwxyz01234", "abcdefghijklmnopqrstuvwxyz012345");
    }

    function r() public pure returns (bytes memory) {
        return abi.encode("abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZab", "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789AB", "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcd");
    }

    function s() public pure returns (bytes memory) {
        return abi.encodePacked("abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcde", uint8(1), "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmn", uint8(2));
    }

    function t() public pure returns (bytes memory b) {
        assembly {
            let p := mload(0x40)
            for { let i := 0 } lt(i, 0x400) { i := add(i, 0x20) } {
                mstore(add(p, i), not(0))
            }
        }
        b = abi.encode("abc", "abcdefghijklmnopqrstuvwxyz0123456", "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcde");
    }
}
