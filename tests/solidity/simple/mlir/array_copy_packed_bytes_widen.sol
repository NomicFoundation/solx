    function set_2ds(bytes9 v00, bytes9 v01, bytes9 v10, bytes9 v11) public {
        delete s9_ds;
        s9_ds.push();
        s9_ds.push();
        s9_ds[0][0] = v00; s9_ds[0][1] = v01;
        s9_ds[1][0] = v10; s9_ds[1][1] = v11;
    }
    function copy_2ds() public { s17_ds = s9_ds; }
