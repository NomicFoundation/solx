        delete s9_sd[0];
        delete s9_sd[1];
        s9_sd[0].push(v00); s9_sd[0].push(v01);
        s9_sd[1].push(v10); s9_sd[1].push(v11);
    }
    function copy_2sd() public { s17_sd = s9_sd; }
    function get_2sd(uint256 i, uint256 j) public view returns (bytes17) { return s17_sd[i][j]; }


