pragma solidity >=0.8.0;

contract Test {
    uint256 counter;

    modifier increment() {
        assembly {
            function one() -> result {
                result := 1
            }
            sstore(counter.slot, add(sload(counter.slot), one()))
        }
        _;
    }

    function first() external increment returns (uint256) {
        return counter;
    }

    function second() external increment returns (uint256) {
        return counter + 10;
    }
}
