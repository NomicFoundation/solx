pragma solidity >=0.8.0;

contract Test {
    string s;
    bytes b;
    mapping(uint256 => string) m;

    function p() internal view returns (uint256 a, uint256 x, uint256 y, uint256 z) {
        assembly {
            a := sload(s.slot)
            mstore(0, s.slot)
            let data := keccak256(0, 0x20)
            x := sload(data)
            y := sload(add(data, 1))
            z := sload(add(data, 2))
        }
    }

    function f() public returns (string memory) {
        s = "abc";
        return s;
    }

    function g() public returns (string memory r, uint256 a, uint256 x, uint256 y, uint256 z) {
        s = "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefgh";
        s = "abcdefghijklmnopqrstuvwxyz01234";
        r = s;
        (a, x, y, z) = p();
    }

    function h() public returns (string memory r, uint256 a, uint256 x, uint256 y, uint256 z) {
        s = "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789AB";
        s = "abcdefghijklmnopqrstuvwxyz012345";
        r = s;
        (a, x, y, z) = p();
    }

    function k() public returns (bytes memory) {
        b = hex"0102";
        return b;
    }

    function l() public returns (string memory) {
        m[1] = "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmn";
        return m[1];
