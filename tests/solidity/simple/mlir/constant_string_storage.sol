    function n() public returns (uint256 a, uint256 x, uint256 y, uint256 z) {
        s = "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZab";
        s = "";
        (a, x, y, z) = p();
    }
}
