pragma solidity >=0.8.0;

contract D {
    string public s;

    constructor(string memory x) {
        s = x;
    }
}

contract Test {
    string t;

    function g(string memory x) external {
        t = x;
    }

    function k(string memory x) external pure returns (string memory) {
        return x;
    }

    fallback(bytes calldata x) external returns (bytes memory) {
        return x;
    }

    function f() public returns (uint256 p, string memory r) {
        this.g("abc");
        assembly {
            p := mload(0x40)
        }
        r = t;
    }

    function h() public view returns (string memory, string memory) {
        return (this.k("abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZab"), this.k("abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmn"));
    }

    function l() public view returns (string memory) {
        function(string memory) external view returns (string memory) x = this.k;
        return x("p");
    }

    function m() public returns (uint256 p, string memory r) {
        D d = new D("d");
        assembly {
            p := mload(0x40)
        }
        r = d.s();
    }

    function n() public returns (string memory) {
        D d = new D{salt: bytes32(uint256(1))}("abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcde");
        return d.s();
    }

    function q() public returns (bool a, bytes memory x, bool b, bytes memory y, bool c, bytes memory z) {
        (a, x) = address(this).call("xyz");
        (b, y) = address(this).staticcall("");
        (c, z) = address(this).delegatecall("abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmn");
    }

    function r() public returns (uint256 p, bytes memory x) {
        (, x) = address(this).call("xyz");
        assembly {
            p := mload(0x40)
        }
    }
}
